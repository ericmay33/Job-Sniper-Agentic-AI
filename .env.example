# Copy to `.env` and fill in. NEVER commit `.env` — this repo is public.
# Keys are added here as the components that need them are actually built.

# --- Postgres ----------------------------------------------------------------
# A local PostgreSQL service, not a container — see docs/STATE.md for the setup.
# Credentials live in your local `.env` only. In that copy, insert the password
# after the username and before the `@`. Never put a filled-in credential in this
# file: the pre-commit secret scanner blocks that shape of URL, correctly.
#
# The scheme stays a plain `postgresql://` DSN. The driver (psycopg 3) is chosen
# in src/jobsniper/db/engine.py, not encoded here.
DATABASE_URL=postgresql://postgres@localhost:5432/jobsniper

# --- LLM provider ------------------------------------------------------------
# Provider-agnostic on purpose. The provider is a value, not an assumption baked
# into call sites: every model call goes through one adapter that reads these.
LLM_PROVIDER=            # e.g. anthropic | openai | openrouter | ollama
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=            # optional; self-hosted or OpenAI-compatible gateways

# --- Contact resolution ------------------------------------------------------
HUNTER_API_KEY=          # T3 vendor cascade, budget-metered last resort
